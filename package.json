{
  "name": "finoracles-web",
  "version": "1.0.0",
  "private": true,
  "description": "FinOracles Services Pvt. Ltd. website — Next.js static export, hosted on Hostinger",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "package": "npm run build && node scripts/package.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cross-env": "^10.1.0",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  }
}
