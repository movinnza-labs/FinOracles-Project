# ─── Core ───────────────────────────────────────────────────────────────
# PostgreSQL connection string. Production values: deploy/hostinger/env.production.example
DATABASE_URL=postgresql://postgres:password@localhost:5432/finoracles

# Long random string used to sign Payload auth tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me

# Public URL of the site (no trailing slash). Used for canonical URLs, sitemap,
# Open Graph tags and CORS/CSRF. In production: your https domain, e.g.
#   NEXT_PUBLIC_SERVER_URL=https://finoracles.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Database connection pool size. 5 is enough for a small site; more connections cost memory.
DATABASE_POOL_MAX=5

# Secret used by the on-demand revalidation + preview endpoints.
REVALIDATE_SECRET=change-me-too

# ─── Media storage ──────────────────────────────────────────────────────
# Option A (default): local disk. On the server use a folder outside the code checkout,
# e.g. MEDIA_DIR=/var/www/finoracles/shared/media
MEDIA_DIR=media

# Option B: S3-compatible bucket (Cloudflare R2, AWS S3, Hostinger Object Storage...).
# When S3_BUCKET is set, uploads go to the bucket instead of MEDIA_DIR.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ─── Email (optional) ───────────────────────────────────────────────────
# When SMTP_HOST is set, new enquiries are emailed to ENQUIRY_NOTIFY_TO.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=no-reply@finoracles.com
EMAIL_FROM_NAME=FinOracles Website
ENQUIRY_NOTIFY_TO=connect@finoracles.com

# ─── Seeding ────────────────────────────────────────────────────────────
# First admin user created by `npm run seed` (or on first boot when SEED_ON_INIT=true).
SEED_ADMIN_EMAIL=admin@finoracles.com
SEED_ADMIN_PASSWORD=
SEED_ON_INIT=false
