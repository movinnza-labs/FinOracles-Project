# FinOracles — production environment for the Hostinger VPS (Docker Compose).
# Copy to /srv/finoracles/app/.env on the server, fill in, then: chmod 600 .env
# Never commit the real file. docker-compose.yml reads it for ${...} substitution and as the
# app's runtime environment. Wrap any value containing "$" in single quotes.

# ─── Database (docker-compose `db` service) ─────────────────────────────
POSTGRES_IMAGE=postgres:17-bookworm
POSTGRES_USER=finoracles
# Hex only (no @ : / ? #), because it is placed inside DATABASE_URL. Generate with:
#   openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_DB=finoracles
# DATABASE_URL is built by docker-compose.yml from the values above; do not set it here.
DATABASE_POOL_MAX=5

# ─── Core ───────────────────────────────────────────────────────────────
# Long random string that signs admin logins. Generate once with: openssl rand -hex 32
# Keep it unchanged afterwards (changing it logs every admin out).
PAYLOAD_SECRET=

# Public URL of the site, no trailing slash: https:// + CANONICAL_HOST (your domain, with or
# without www, as you want visitors to see it). Drives canonical URLs, sitemap, CORS and CSRF.
# Compiled into the build: rebuild (deploy.sh) after changing it.
NEXT_PUBLIC_SERVER_URL=https://CANONICAL_HOST

# Present in .env.example; not read by the current code. Harmless to keep.
REVALIDATE_SECRET=

# ─── Media storage ──────────────────────────────────────────────────────
# Local disk: /app/media inside the container, bind-mounted from MEDIA_HOST_DIR on the host.
MEDIA_DIR=media
MEDIA_HOST_DIR=/srv/finoracles/media
# Leave all S3_* empty on the VPS so uploads use the local disk above.
S3_BUCKET=
S3_PUBLIC_URL=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ─── Email (optional: enquiry notifications) ────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=no-reply@finoracles.com
EMAIL_FROM_NAME=FinOracles Website
ENQUIRY_NOTIFY_TO=connect@finoracles.com

# ─── Seeding ────────────────────────────────────────────────────────────
# First start on the new, empty database: loads the website's built-in content and images and
# creates the first admin login below. It only runs while the database is empty, so it never
# overwrites content. After the first successful start set SEED_ON_INIT=false and clear
# SEED_ADMIN_PASSWORD, then run: docker compose up -d app
SEED_ON_INIT=true
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ─── Container limits ───────────────────────────────────────────────────
APP_MEM_LIMIT=1536m
