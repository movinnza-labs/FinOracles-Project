# FinOracles nightly backup. Install: sudo install -m 644 -o root -g root deploy/cron/finoracles-backup /etc/cron.d/
# Runs at 02:30 server time (set the server timezone: sudo timedatectl set-timezone Asia/Kolkata).
# Output goes to the system journal: journalctl -t finoracles-backup
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

30 2 * * * root /bin/bash /srv/finoracles/app/deploy/scripts/backup.sh 2>&1 | logger -t finoracles-backup
