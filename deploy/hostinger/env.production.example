# Production settings for Hostinger. Copy to the app directory as `.env` (VPS) or enter each
# line in hPanel → Websites → Node.js app → Environment variables (Business / Cloud plans).
# Never commit the filled-in file. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

NODE_ENV=production

# ─── Core ───────────────────────────────────────────────────────────────
# VPS: local PostgreSQL created in README step 3.
# Business/Cloud: an external PostgreSQL (e.g. Neon or Supabase), because those plans include
# MySQL only. Append ?sslmode=require when the provider requires SSL.
DATABASE_URL=postgresql://finoracles:CHANGE_ME@127.0.0.1:5432/finoracles
DATABASE_POOL_MAX=10

PAYLOAD_SECRET=CHANGE_ME_64_HEX_CHARS
REVALIDATE_SECRET=CHANGE_ME_48_HEX_CHARS

# Your live domain, https, no trailing slash. Used for canonical URLs, sitemap, Open Graph,
# admin CORS/CSRF and image domains. NEXT_PUBLIC_* values are baked in at build time:
# rebuild after changing it.
NEXT_PUBLIC_SERVER_URL=https://finoracles.com

# ─── Media storage ──────────────────────────────────────────────────────
# VPS: a folder outside the code checkout so deploys never touch uploads.
MEDIA_DIR=/var/www/finoracles/shared/media
# Business/Cloud: use an S3-compatible bucket instead (Cloudflare R2, AWS S3, Hostinger
# Object Storage). When S3_BUCKET is set, MEDIA_DIR is ignored.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Public base URL of the bucket, if images are served from it directly.
S3_PUBLIC_URL=

# ─── Email (optional) ───────────────────────────────────────────────────
# Hostinger mail: smtp.hostinger.com, port 465 (SSL) with a mailbox you created in hPanel.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=no-reply@finoracles.com
EMAIL_FROM_NAME=FinOracles Website
ENQUIRY_NOTIFY_TO=connect@finoracles.com

# ─── Seeding ────────────────────────────────────────────────────────────
# Keep false in production when moving existing content with transfer-data.sh.
SEED_ON_INIT=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
